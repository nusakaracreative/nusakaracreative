{
  "ci": {
    "collect": {
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "color-contrast": [
          "error",
          {
            "minScore": 1
          }
        ],
        "errors-in-console": [
          "error",
          {
            "maxLength": 0
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
